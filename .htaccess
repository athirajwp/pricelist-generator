<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex backend/public/index.php public/index.php index.php index.html

    # Route all incoming requests to backend/public/
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>
